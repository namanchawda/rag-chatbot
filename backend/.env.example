DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@localhost:5432/rag_chatbot
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
JINA_API_KEY=CHANGE_ME_your_jina_api_key
JINA_EMBEDDING_MODEL=jina-embeddings-v5-omni-small
EMBEDDING_DIMENSION=1024
MAX_UPLOAD_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
GROQ_API_KEY=CHANGE_ME_your_groq_api_key
GROQ_MODEL=CHANGE_ME_your_groq_model_name
RETRIEVAL_TOP_K=5
MAX_QUESTION_CHARS=2000
RERANK_ENABLED=true
JINA_RERANK_MODEL=jina-reranker-v3.5
RETRIEVAL_CANDIDATES=20
RERANK_TOP_N=5
# Optional cutoff; leave unset until real scores have been observed on the live API.
#RERANK_MIN_SCORE=0.0
RERANK_LOG_SCORES=false
